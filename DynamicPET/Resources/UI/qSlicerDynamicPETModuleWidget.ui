                          </property>
                        </widget>
                      </item>
                    </layout>
                  </item>
                </layout>
              </widget>
            </item>
          </layout>
        </widget>
        <widget class="QWidget" name="ROIModelingWidget"><attribute name="title"><string>ROI Modeling</string></attribute><layout class="QVBoxLayout" name="verticalLayoutROIModeling" stretch="0"><item><widget class="QTabWidget" name="ROIModelsTabWidget"><widget class="QWidget" name="MTGAWidget">
          <attribute name="title">
