                  <item row="2" column="0">
                    <layout class="QHBoxLayout" name="excelSaveLayout3">
                      <item>
                        <widget class="QPushButton" name="plotButton">
                          <property name="icon">
                            <iconset resource="../qSlicerDynamicPETModule.qrc">
                              <normaloff>:/Icons/PLOT.jpg</normaloff> <!-- Provide your icon -->
                            </iconset>
                          </property>
                          <property name="toolTip">
                            <string>Plot TAC statistics</string>
                          </property>
                        </widget>
                      </item>
                      <item>
                        <widget class="QCheckBox" name="PlotLiveSegEdit">
                         <property name="toolTip">
                          <string>Image mode only. Track Segment Editor changes and refresh image-derived TACs after segmentation corrections.</string>
                         </property>
                         <property name="text">
                          <string>SegmentEditor corrections</string>
                         </property>
                         <property name="checked">
                          <bool>true</bool>
                         </property>
                        </widget>
                      </item>
                      <item>
                        <widget class="QCheckBox" name="PlotErrorCheckbox">
                         <property name="toolTip">
                          <string>Show vertical bars when available. In image mode these are ROI dispersion measures (SD for Mean, IQR/1.349 for Median, local SUVpeak-region SD for Peak), not automatically the uncertainty of the ROI estimator. In Table mode imported one-sigma uncertainty is used. Max has no automatic image-derived uncertainty.</string>
                         </property>
                         <property name="text">
                          <string>Show error / dispersion bars</string>
                         </property>
                         <property name="checked">
                          <bool>false</bool>
                         </property>
                        </widget>
                      </item>
                    </layout>
                  </item>
                  <item row="2" column="1">
                    <widget class="QPushButton" name="RESETbutton">
                     <property name="enabled">
                      <bool>true</bool>
                     </property>
                     <property name="toolTip">
                      <string>Restore removed points from the plot chart.</string>
                     </property>
                     <property name="text">
                      <string>Reset</string>
                     </property>
                     <property name="default">
                      <bool>true</bool>
                     </property>
                    </widget>
                  </item>
                  <item row="3" column="0">
                   <widget class="QLabel" name="Plottacsave">
                    <property name="text">
                     <string>Save TAC:</string>
                    </property>
                   </widget>
                  </item>
                  <item row="3" column="1">
                    <layout class="QHBoxLayout" name="excelSaveLayout">
                      <item>
                        <widget class="ctkPathLineEdit" name="direxcel">
                          <property name="toolTip">
                            <string>Choose directory to save EXCEL.</string>
                          </property>
                          <property name="enabled">
                            <bool>true</bool>
                          </property>
                          <property name="filters">
                            <set>ctkPathLineEdit::Dirs|ctkPathLineEdit::Drives|ctkPathLineEdit::Executable|ctkPathLineEdit::NoDot|ctkPathLineEdit::NoDotDot|ctkPathLineEdit::Readable</set>
                          </property>
