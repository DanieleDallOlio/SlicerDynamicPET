            <item>
              <widget class="ctkCollapsibleButton" name="MTGACollapsibleButton">
                <property name="text">
                 <string>MTGA Parameters</string>
                </property>
                <layout class="QGridLayout" name="MTGAFormLayout">
                  <item row="0" column="0">
                    <widget class="QLabel" name="timeOffsetLabel">
                      <property name="text">
                        <string>Regression start</string>
                      </property>
                    </widget>
                  </item>
                  <item row="0" column="1">
                    <widget class="QSlider" name="timeOffsetSlider">
                      <property name="orientation">
                        <enum>Qt::Horizontal</enum>
                      </property>
                      <property name="minimum">
                        <number>0</number>
                      </property>
                      <property name="maximum">
                        <number>100</number>
                      </property>
                      <property name="value">
                        <number>10</number>
                      </property>
                    </widget>
                  </item>
                  <item row="1" column="1">
                    <widget class="QWidget" name="sliderInfoWidget">
                      <layout class="QHBoxLayout" name="horizontalLayout">

                        <!-- Frame -->
                        <item>
                          <layout class="QVBoxLayout" name="frameLayout">
                            <item>
                              <widget class="QLabel" name="frameLabel">
                                <property name="text">
                                  <string>#Frame</string>
                                </property>
                                <property name="alignment">
                                  <set>Qt::AlignCenter</set>
                                </property>
                              </widget>
                            </item>
                            <item>
                              <widget class="QLineEdit" name="frameEdit">
                                <property name="readOnly">
                                  <bool>true</bool>
                                </property>
                                <property name="alignment">
                                  <set>Qt::AlignCenter</set>
                                </property>
                                <property name="sizePolicy">
                                  <sizepolicy hsizetype="Minimum" vsizetype="Fixed">
                                    <horStretch>0</horStretch>
                                    <verStretch>0</verStretch>
                                  </sizepolicy>
                                </property>
                              </widget>
                            </item>
                          </layout>
                        </item>

                        <!-- Time (s) -->
                        <item>
                          <layout class="QVBoxLayout" name="timeSecLayout">
                            <item>
                              <widget class="QLabel" name="timeSecLabel">
                                <property name="text">
                                  <string>Frame end (s)</string>
                                </property>
                                <property name="alignment">
                                  <set>Qt::AlignCenter</set>
                                </property>
                              </widget>
                            </item>
                            <item>
                              <widget class="QLineEdit" name="timeSecEdit">
                                <property name="readOnly">
                                  <bool>true</bool>
                                </property>
                                <property name="alignment">
                                  <set>Qt::AlignCenter</set>
                                </property>
                                <property name="sizePolicy">
                                  <sizepolicy hsizetype="Minimum" vsizetype="Fixed">
                                    <horStretch>0</horStretch>
                                    <verStretch>0</verStretch>
                                  </sizepolicy>
                                </property>
                              </widget>
                            </item>
                          </layout>
                        </item>

                        <!-- Time (min) -->
                        <item>
                          <layout class="QVBoxLayout" name="timeMinLayout">
                            <item>
                              <widget class="QLabel" name="timeMinLabel">
                                <property name="text">
                                  <string>Frame end (min)</string>
                                </property>
                                <property name="alignment">
                                  <set>Qt::AlignCenter</set>
                                </property>
                              </widget>
                            </item>
                            <item>
                              <widget class="QLineEdit" name="timeMinEdit">
                                <property name="readOnly">
                                  <bool>true</bool>
                                </property>
                                <property name="alignment">
                                  <set>Qt::AlignCenter</set>
                                </property>
                                <property name="sizePolicy">
                                  <sizepolicy hsizetype="Minimum" vsizetype="Fixed">
                                    <horStretch>0</horStretch>
                                    <verStretch>0</verStretch>
                                  </sizepolicy>
                                </property>
                              </widget>
                            </item>
                          </layout>
                        </item>

                      </layout>
                    </widget>
                  </item>
                  <item row="2" column="0"><widget class="QLabel" name="timeEndLabel"><property name="text"><string>Regression end</string></property></widget></item><item row="2" column="1"><widget class="QSlider" name="timeEndSlider"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>1</number></property><property name="maximum"><number>100</number></property><property name="value"><number>100</number></property><property name="toolTip"><string>Last PET frame included in the MTGA regression. The UI reports the frame end time; the graphical analysis still uses the selected frame midpoint internally.</string></property></widget></item><item row="3" column="1"><widget class="QLineEdit" name="timeEndInfoEdit"><property name="readOnly"><bool>true</bool></property><property name="toolTip"><string>Selected end frame and its complete frame end time.</string></property></widget></item><item row="4" column="0">
                    <widget class="QLabel" name="framingNormLabel">
                      <property name="text">
