            <item>
             <widget class="QWidget" name="QuantitativeDisplayWidget" native="true">
              <layout class="QHBoxLayout" name="QuantitativeDisplayLayout">
               <property name="leftMargin"><number>0</number></property>
               <property name="topMargin"><number>0</number></property>
               <property name="rightMargin"><number>0</number></property>
               <property name="bottomMargin"><number>0</number></property>
               <item>
                <widget class="QLabel" name="QuantitativeDisplayUnitLabel">
                 <property name="text">
                  <string>Display units:</string>
                 </property>
                 <property name="toolTip">
                  <string>General display/export choice for quantitative activity curves. Kinetic fitting remains in the PET sequence native quantitative scale, so switching display units cannot change fitted parameters.</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QComboBox" name="QuantitativeDisplayUnitSelector">
                 <property name="toolTip">
                  <string>Display quantitative activity curves as SUVbw or Bq/mL when a validated SUVbw conversion factor is available. This does not change the fitting scale.</string>
                 </property>
                 <item><property name="text"><string>SUVbw</string></property></item>
                 <item><property name="text"><string>Bq/mL</string></property></item>
                </widget>
               </item>
               <item>
                <spacer name="QuantitativeDisplaySpacer">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0">
                  <size><width>40</width><height>20</height></size>
                 </property>
                </spacer>
               </item>
              </layout>
             </widget>
            </item>
            <item>
              <widget class="ctkCollapsibleButton" name="InputFunctionCollapsibleButton">
                <property name="text">
                  <string>Input Function</string>
                </property>
                <property name="collapsed">
                  <bool>false</bool>
                </property>

                <layout class="QGridLayout" name="InputFunctionLayout">

                  <!-- Source -->
                  <item row="0" column="0">
                    <widget class="QLabel" name="IFSourceLabel">
                      <property name="text">
                        <string>Source:</string>
                      </property>
                    </widget>
                  </item>

                  <item row="0" column="1">
                    <widget class="QComboBox" name="IFSourceSelector">
                      <item>
                        <property name="text">
                          <string>Segment (IDIF)</string>
                        </property>
                      </item>
                      <item>
                        <property name="text">
                          <string>External CSV</string>
                        </property>
                      </item>
                    </widget>
                  </item>

                  <!-- IDIF segment -->
                  <item row="1" column="0">
                    <widget class="QLabel" name="IFLabel">
                      <property name="text">
                        <string>IDIF segment:</string>
                      </property>
                    </widget>
                  </item>

                  <item row="1" column="1">
                    <widget class="QComboBox" name="IFSelector">
                      <property name="toolTip">
                        <string>The selected segment or table ROI TAC is used as the input function and treated as total whole blood. The same downstream plasma conversion, optional PBIF calibration, source processing, and parent-fraction correction are then applied.</string>
                      </property>
                    </widget>
                  </item>

                  <!-- IDIF statistic -->
                  <item row="2" column="0">
                    <widget class="QLabel" name="IFStatLabel">
                      <property name="text">
                        <string>IDIF statistic:</string>
                      </property>
                    </widget>
                  </item>

                  <item row="2" column="1">
                    <widget class="QComboBox" name="IFStatSelector">
                      <property name="toolTip">
                        <string>Choose Mean, Median, or Peak for the segment-derived input function.</string>
                      </property>
                    </widget>
                  </item>

                  <item row="3" column="0">
                    <widget class="QLabel" name="IFCSVFileLabel">
                      <property name="text">
                        <string>CSV file:</string>
                      </property>
                      <property name="toolTip">
                        <string>CSV format must be exactly two columns with header time_s,concentration. Time is in seconds. Select the physical units of the concentration values explicitly; SlicerDynamicPET converts them to the PET sequence native quantitative scale before fitting.</string>
                      </property>
                    </widget>
                  </item>

                  <item row="3" column="1">
                    <layout class="QHBoxLayout" name="IFCSVFileLayout">
                      <item>
                        <widget class="QLineEdit" name="IFCSVPathEdit">
                          <property name="readOnly">
                            <bool>true</bool>
                          </property>
                          <property name="placeholderText">
                            <string>No CSV selected</string>
                          </property>
                        </widget>
                      </item>
                      <item>
                        <widget class="QComboBox" name="IFCSVUnitSelector">
                          <property name="toolTip">
                            <string>Physical units of the external input-function values. The curve is converted internally to the PET sequence native quantitative scale before fitting.</string>
                          </property>
                          <item><property name="text"><string>Bq/mL</string></property></item>
                          <item><property name="text"><string>kBq/mL</string></property></item>
                          <item><property name="text"><string>SUVbw</string></property></item>
                        </widget>
                      </item>
                      <item>
                        <widget class="QPushButton" name="IFCSVBrowseButton">
                          <property name="text">
                            <string>Browse...</string>
                          </property>
                        </widget>
                      </item>
                    </layout>
                  </item>

                  <item row="4" column="0">
                    <widget class="QLabel" name="IFCurveTypeLabel">
                      <property name="text">
                        <string>Curve represents:</string>
                      </property>
                    </widget>
                  </item>

                  <item row="4" column="1">
                    <widget class="QComboBox" name="IFCurveTypeSelector">
                      <property name="toolTip">
                        <string>Biological domain of an external input-function CSV. Whole blood is the default. Segment-derived IDIFs are always treated as whole blood. Total plasma and parent plasma are available for externally supplied curves.</string>
                      </property>
                      <item>
                        <property name="text">
                          <string>Whole blood</string>
                        </property>
                      </item>
                      <item>
                        <property name="text">
                          <string>Total plasma</string>
                        </property>
                      </item>
                      <item>
                        <property name="text">
                          <string>Parent plasma</string>
                        </property>
                      </item>
                    </widget>
                  </item>

                  <!-- Companion whole-blood curve for parent-plasma input -->
                  <item row="5" column="0">
                    <widget class="QLabel" name="IFWholeBloodFileLabel">
                      <property name="text">
                        <string>Whole-blood CSV:</string>
                      </property>
                      <property name="toolTip">
                        <string>Required for TCM when the external input-function CSV already represents parent plasma. Format: time_s,concentration.</string>
                      </property>
                    </widget>
                  </item>

                  <item row="5" column="1">
                    <layout class="QHBoxLayout" name="IFWholeBloodFileLayout">
                      <item>
                        <widget class="QLineEdit" name="IFWholeBloodPathEdit">
                          <property name="readOnly">
                            <bool>true</bool>
                          </property>
                          <property name="placeholderText">
                            <string>No whole-blood CSV selected</string>
                          </property>
                        </widget>
                      </item>
                      <item>
                        <widget class="QComboBox" name="IFWholeBloodUnitSelector">
                          <property name="toolTip">
                            <string>Physical units of the companion whole-blood values. The curve is converted internally to the PET sequence native quantitative scale before TCM fitting.</string>
                          </property>
                          <item><property name="text"><string>Bq/mL</string></property></item>
                          <item><property name="text"><string>kBq/mL</string></property></item>
                          <item><property name="text"><string>SUVbw</string></property></item>
                        </widget>
                      </item>
                      <item>
                        <widget class="QPushButton" name="IFWholeBloodBrowseButton">
                          <property name="text">
                            <string>Browse...</string>
                          </property>
                        </widget>
                      </item>
                      <item>
                        <widget class="QPushButton" name="IFWholeBloodPreviewButton">
                          <property name="text">
                            <string>Preview</string>
                          </property>
                        </widget>
                      </item>
                    </layout>
                  </item>

                  <!-- Status -->
                  <item row="6" column="0" colspan="2">
                    <widget class="QLabel" name="IFStatusLabel">
                      <property name="text">
                        <string>No input function selected.</string>
                      </property>
                      <property name="wordWrap">
                        <bool>true</bool>
                      </property>
                    </widget>
                  </item>

                  <item row="7" column="0" colspan="2">
                    <layout class="QHBoxLayout" name="IFPreviewExportLayout">
                      <item>
                        <widget class="QPushButton" name="IFPreviewButton">
                          <property name="text"><string>Preview input function</string></property>
                          <property name="toolTip"><string>Plot the original input-function samples and the effective plasma and whole-blood curves used by the kinetic models. External CSV source observations can be selected in this preview and excluded with Delete.</string></property>
                        </widget>
                      </item>
                      <item>
                        <widget class="QPushButton" name="IFExportButton">
                          <property name="text"><string>Export final IF CSV...</string></property>
                          <property name="toolTip"><string>Export the final plasma curve used by the kinetic model after the selected source processing, plasma/whole-blood conversion, PBIF scaling, and parent-fraction correction. The CSV uses the standard time_s,concentration format and the currently selected display activity unit.</string></property>
                        </widget>
                      </item>
                    </layout>
                  </item>

                  <!-- Advanced -->
                  <item row="8" column="0" colspan="2">
                    <widget class="ctkCollapsibleButton" name="IFAdvancedCollapsibleButton">
                      <property name="text">
                        <string>Advanced</string>
                      </property>
                      <property name="collapsed">
                        <bool>true</bool>
                      </property>

                      <layout class="QGridLayout" name="IFAdvancedLayout">

                        <!-- Source modelling / denoising -->
                        <item row="0" column="0">
                          <widget class="QLabel" name="IFSourceProcessingLabel">
                            <property name="text">
                              <string>Input-function denoising / modeling</string>
                            </property>
                          </widget>
                        </item>
                        <item row="0" column="1" colspan="3">
                          <widget class="QComboBox" name="IFSourceProcessingSelector">
                            <property name="toolTip">
                              <string>Optional denoising or analytic modeling of the measured patient-specific source curve before blood/plasma conversion and PBIF calibration. LOWESS is robust but may attenuate a sharp bolus. Gaussian kernel smoothing is a gentler, directly tunable alternative for irregularly sampled data. Feng fits the standard analytic input-function model. For a smooth curve that still passes through retained observations without denoising, leave processing at None and choose shape-preserving cubic (PCHIP) interpolation below.</string>
                            </property>
                            <item><property name="text"><string>None</string></property></item>
                            <item><property name="text"><string>LOWESS smoothing</string></property></item>
                            <item><property name="text"><string>Gaussian smoothing</string></property></item>
                            <item><property name="text"><string>Feng model</string></property></item>
                          </widget>
                        </item>

                        <!-- LOWESS settings -->
                        <item row="1" column="0">
                          <widget class="QLabel" name="IFLowessSpanLabel">
                            <property name="text"><string>LOWESS span</string></property>
                            <property name="toolTip"><string>Fraction of retained source observations used in each local linear LOWESS fit. Two robust bisquare reweighting iterations are applied. Smaller spans follow the data more closely; larger spans smooth more strongly.</string></property>
                          </widget>
                        </item>
                        <item row="1" column="1">
                          <widget class="QDoubleSpinBox" name="IFLowessSpanSpinBox">
                            <property name="decimals"><number>2</number></property>
                            <property name="minimum"><double>0.050000000000000</double></property>
                            <property name="maximum"><double>1.000000000000000</double></property>
                            <property name="singleStep"><double>0.050000000000000</double></property>
                            <property name="value"><double>0.250000000000000</double></property>
                          </widget>
                        </item>
                        <item row="1" column="2">
                          <widget class="QLabel" name="IFGaussianSigmaLabel">
                            <property name="text"><string>Gaussian sigma</string></property>
                            <property name="toolTip"><string>Gaussian kernel width in seconds. Smaller values preserve the measured bolus shape more closely; larger values provide stronger denoising. The kernel works directly on irregular sample times.</string></property>
                          </widget>
                        </item>
                        <item row="1" column="3">
                          <widget class="QDoubleSpinBox" name="IFGaussianSigmaSpinBox">
                            <property name="decimals"><number>1</number></property>
                            <property name="minimum"><double>0.100000000000000</double></property>
                            <property name="maximum"><double>600.000000000000000</double></property>
                            <property name="singleStep"><double>0.500000000000000</double></property>
                            <property name="value"><double>1.000000000000000</double></property>
                            <property name="suffix"><string> s</string></property>
                          </widget>
                        </item>

                        <!-- Input interpolation -->
                        <item row="2" column="0">
                          <widget class="QLabel" name="IFInterpolationLabel">
                            <property name="text"><string>Input interpolation</string></property>
                          </widget>
                        </item>
                        <item row="2" column="1" colspan="3">
                          <widget class="QComboBox" name="IFInterpolationSelector">
                            <property name="toolTip">
                              <string>Interpolation used to evaluate the input function between available samples. Linear is conservative. Piecewise constant holds frame/sample values between sampling locations. Shape-preserving cubic spline (PCHIP) gives a smooth curve through the retained observations while limiting overshoot; unlike LOWESS it does not denoise or attenuate the measured peak.</string>
                            </property>
                            <item><property name="text"><string>Linear</string></property></item>
                            <item><property name="text"><string>Piecewise constant</string></property></item>
                            <item><property name="text"><string>Shape-preserving cubic spline</string></property></item>
                          </widget>
                        </item>

                        <!-- Fine time step -->
                        <item row="3" column="0">
                          <widget class="QLabel" name="timeStepLabel">
                            <property name="text"><string>TCM integration time step</string></property>
                            <property name="toolTip">
                              <string>Uniform internal time step used to fine-sample plasma, whole blood, and parent-fraction curves for TCM convolution and delay correction.</string>
                            </property>
                          </widget>
                        </item>
                        <item row="3" column="1">
                          <widget class="QLineEdit" name="timeStepEdit">
                            <property name="text"><string>1.0</string></property>
                          </widget>
                        </item>
                        <item row="3" column="2">
                          <widget class="QLabel" name="timeStepUnitLabel">
                            <property name="text"><string>s</string></property>
                          </widget>
                        </item>

                        <!-- Plasma / whole-blood -->
                        <item row="4" column="0">
                          <widget class="QLabel" name="pbrpLabel">
                            <property name="text"><string>Plasma / whole-blood ratio</string></property>
                            <property name="toolTip">
                              <string>PBR(t) = p1·exp(-p2·t/60) + p3 relates total plasma and total whole blood: Cp,total = Cwb,total × PBR. Parent plasma is never converted to whole blood with this ratio.</string>
                            </property>
                          </widget>
                        </item>
                        <item row="4" column="1">
                          <widget class="QLineEdit" name="pbrp1Edit">
                            <property name="text"><string>1.0</string></property>
                            <property name="toolTip"><string>p1</string></property>
                          </widget>
                        </item>
                        <item row="4" column="2">
                          <widget class="QLineEdit" name="pbrp2Edit">
                            <property name="text"><string>0.0</string></property>
                            <property name="toolTip"><string>p2</string></property>
                          </widget>
                        </item>
                        <item row="4" column="3">
                          <widget class="QLineEdit" name="pbrp3Edit">
                            <property name="text"><string>0.0</string></property>
                            <property name="toolTip"><string>p3</string></property>
                          </widget>
                        </item>

                        <!-- PBIF calibration -->
                        <item row="5" column="0" colspan="4">
                          <widget class="QCheckBox" name="PBIFOptionCheckBox">
                            <property name="text"><string>Use PBIF calibration</string></property>
                            <property name="toolTip">
                              <string>Scale a supplied population template to the current patient-specific IF using an AUC ratio over the selected calibration interval. The patient IF is calibration evidence; the scaled PBIF becomes the model input representation.</string>
                            </property>
                          </widget>
                        </item>
                        <item row="6" column="0">
                          <widget class="QLabel" name="PBIFFileLabel">
                            <property name="text"><string>PBIF template CSV</string></property>
                            <property name="toolTip"><string>Format: time_s,template_value.</string></property>
                          </widget>
                        </item>
                        <item row="6" column="1" colspan="3">
                          <layout class="QHBoxLayout" name="PBIFFileLayout">
                            <item><widget class="QLineEdit" name="PBIFPathEdit"><property name="readOnly"><bool>true</bool></property><property name="placeholderText"><string>No PBIF selected</string></property></widget></item>
                            <item><widget class="QPushButton" name="PBIFBrowseButton"><property name="text"><string>Browse...</string></property></widget></item>
                            <item><widget class="QPushButton" name="PBIFPreviewButton"><property name="text"><string>Preview</string></property></widget></item>
                          </layout>
                        </item>
                        <item row="7" column="0">
                          <widget class="QLabel" name="PBIFDomainLabel">
                            <property name="text"><string>PBIF template represents</string></property>
                            <property name="toolTip"><string>Select the biological domain of the supplied PBIF template. The patient calibration curve is converted to the same domain before AUC scaling.</string></property>
                          </widget>
                        </item>
                        <item row="7" column="1" colspan="3">
                          <widget class="QComboBox" name="PBIFDomainSelector">
                            <property name="toolTip"><string>Domain represented by the PBIF template itself. Choose Whole blood or Total plasma; DynamicPET converts the patient calibration curve to the matching domain before scaling.</string></property>
                            <item><property name="text"><string>Whole blood</string></property></item>
                            <item><property name="text"><string>Total plasma</string></property></item>
                          </widget>
                        </item>
                        <item row="8" column="0">
                          <widget class="QLabel" name="PBIFCalibrationIntervalLabel"><property name="text"><string>AUC calibration interval</string></property></widget>
                        </item>
                        <item row="8" column="1">
                          <widget class="QDoubleSpinBox" name="PBIFCalibrationStartSpinBox">
                            <property name="decimals"><number>3</number></property>
                            <property name="maximum"><double>1000000.000000000000000</double></property>
                            <property name="suffix"><string> s</string></property>
                          </widget>
                        </item>
                        <item row="8" column="2">
                          <widget class="QLabel" name="PBIFCalibrationToLabel"><property name="text"><string>to</string></property></widget>
                        </item>
                        <item row="8" column="3">
                          <widget class="QDoubleSpinBox" name="PBIFCalibrationEndSpinBox">
                            <property name="decimals"><number>3</number></property>
                            <property name="maximum"><double>1000000.000000000000000</double></property>
                            <property name="suffix"><string> s</string></property>
                          </widget>
                        </item>

                        <!-- Metabolite / parent-fraction correction -->
                        <item row="9" column="0" colspan="4">
                          <widget class="QCheckBox" name="MetaboliteCorrectionCheckBox">
                            <property name="text"><string>Apply parent-fraction correction</string></property>
                            <property name="toolTip">
                              <string>Convert total plasma to parent plasma using a supplied parent-fraction curve. Disabled when the external source already represents parent plasma.</string>
                            </property>
                          </widget>
                        </item>
                        <item row="10" column="0">
                          <widget class="QLabel" name="ParentFractionFileLabel">
                            <property name="text"><string>Parent-fraction CSV</string></property>
                            <property name="toolTip"><string>Format: time_s,parent_fraction with values between 0 and 1.</string></property>
                          </widget>
                        </item>
                        <item row="10" column="1" colspan="3">
                          <layout class="QHBoxLayout" name="ParentFractionFileLayout">
                            <item><widget class="QLineEdit" name="ParentFractionPathEdit"><property name="readOnly"><bool>true</bool></property><property name="placeholderText"><string>No parent-fraction CSV selected</string></property></widget></item>
                            <item><widget class="QPushButton" name="ParentFractionBrowseButton"><property name="text"><string>Browse...</string></property></widget></item>
                            <item><widget class="QPushButton" name="ParentFractionPreviewButton"><property name="text"><string>Preview</string></property></widget></item>
                          </layout>
                        </item>
                        <item row="11" column="0">
                          <widget class="QLabel" name="ParentFractionProcessingLabel"><property name="text"><string>Parent-fraction processing</string></property><property name="toolTip"><string>Linear uses the supplied measurements directly. Hill and exponential models start at parent fraction 1. Extended Hill also estimates an initial plateau and delay. Parametric fits may extrapolate beyond the last metabolite sample; linear interpolation does not.</string></property></widget>
                        </item>
                        <item row="11" column="1" colspan="3">
                          <widget class="QComboBox" name="ParentFractionProcessingSelector">
                            <item><property name="text"><string>Linear interpolation</string></property></item>
                            <item><property name="text"><string>Hill</string></property></item>
                            <item><property name="text"><string>Extended Hill</string></property></item>
                            <item><property name="text"><string>Exponential to plateau</string></property></item>
                          </widget>
                        </item>

                      </layout>
                    </widget>
                  </item>

                </layout>
              </widget>
            </item>
            <item>
              <widget class="ctkCollapsibleButton" name="TACCollapsibleButton">
                <property name="text">
                 <string>Plot</string>
                </property>
                <layout class="QFormLayout" name="formLayout_2">
                  <item row="0" column="0">
