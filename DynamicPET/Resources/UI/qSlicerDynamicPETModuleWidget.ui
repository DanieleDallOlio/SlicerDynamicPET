               </item>
               <item row="3" column="1">
                <widget class="QLineEdit" name="TableSUVbwFactorEdit">
                 <property name="toolTip">
                  <string>Conversion convention: SUVbw = (Bq/mL) × factor; therefore Bq/mL = SUVbw / factor. Required only when conversion between SUVbw and activity concentration is needed.</string>
                 </property>
