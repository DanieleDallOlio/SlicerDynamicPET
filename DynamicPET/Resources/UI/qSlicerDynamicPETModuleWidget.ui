                  <item row="4" column="1">
                    <widget class="QLineEdit" name="framingNormEdit">
                      <property name="text">
                        <string>60.0</string>
                      </property>
                    </widget>
                  </item>
                  <item row="5" column="0" colspan="2">
                    <widget class="QCheckBox" name="standardizationCheckBox">
                      <property name="text">
                        <string>Standardize Data</string>
                      </property>
                      <property name="checked">
                        <bool>true</bool>
                      </property>
                    </widget>
                  </item>
                  <item row="6" column="0">
                    <widget class="QLabel" name="regressionmodel">
                      <property name="text">
                        <string>Regression Model:</string>
                      </property>
                    </widget>
                  </item>
                  <item row="7" column="0" colspan="4">
                    <layout class="QHBoxLayout" name="fitOptionsLayout">
                      <item>
                        <widget class="QCheckBox" name="olsFitCheckBox">
                          <property name="text">
                            <string>OLS</string>
                          </property>
                          <property name="checked">
                            <bool>true</bool>
                          </property>
                          <property name="toolTip">
                           <string>Ordinary Least Squares.</string>
                          </property>
                        </widget>
                      </item>
                      <item>
                        <widget class="QCheckBox" name="weightedFitCheckBox">
                          <property name="text">
                            <string>WLS</string>
                          </property>
                          <property name="checked">
                            <bool>false</bool>
                          </property>
                          <property name="toolTip">
                           <string>Weighted Least Squares using inverse-variance proxy weights: ROI SD for Mean, IQR/1.349 for Median, and local SUVpeak-region SD for Peak.</string>
                          </property>
                        </widget>
                      </item>
                      <item>
                        <widget class="QCheckBox" name="robustFitCheckBox">
                          <property name="text">
                            <string>RLS</string>
                          </property>
                          <property name="checked">
                            <bool>false</bool>
                          </property>
                          <property name="toolTip">
                           <string>Robust Least Squares using Huber IRLS with a MAD-based residual scale. Huber tune 1.345 is the standard Gaussian-efficiency default.</string>
                          </property>
                        </widget>
                      </item>
                    </layout>
