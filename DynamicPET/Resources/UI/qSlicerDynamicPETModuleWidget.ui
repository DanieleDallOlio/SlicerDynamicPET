                    <!-- MTGA model-selected Ki/DV map. Enabled after Patlak and at least one reversible model are fitted. -->
                    <item>
                      <widget class="ctkCollapsibleButton" name="MTGAOptimizationCollapsibleButtonImg">
                        <property name="enabled">
                          <bool>false</bool>
                        </property>
