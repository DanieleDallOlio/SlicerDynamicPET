            </item>
            <item>
              <widget class="ctkCollapsibleButton" name="MTGAResultsButton">
                <property name="text">
                 <string>Results</string>
                </property>
                <layout class="QGridLayout" name="MTGAResultsFormLayout">
                  <item row="0" column="0">
                   <widget class="QLabel" name="voires">
                    <property name="text">
                     <string>VOI</string>
                    </property>
                   </widget>
                  </item>
                  <item row="0" column="1">
                   <widget class="QComboBox" name="VOISelectorMTGA">
                     <property name="toolTip">
                      <string>Choose VOI results.</string>
                     </property>
                   </widget>
                  </item>
                  <item row="1" column="0" colspan="2">
                    <widget class="QTableWidget" name="MTGAResultsTable">
