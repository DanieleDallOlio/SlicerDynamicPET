                    <!-- Output destination shared by standard and optimized TCM maps -->
                    <item>
                      <widget class="ctkCollapsibleButton" name="TCMOutputCollapsibleButtonImg">
                        <property name="text">
                          <string>Output</string>
                        </property>
                        <property name="collapsed"><bool>false</bool></property>
                        <layout class="QGridLayout" name="TCMOutputLayoutImg">
                          <item row="0" column="0" colspan="2">
                            <widget class="QCheckBox" name="TCMShowInSlicerCheckBoxImg">
                              <property name="toolTip"><string>Add generated quantitative parametric maps to the Slicer scene.</string></property>
                              <property name="text"><string>Show in Slicer</string></property>
                              <property name="checked"><bool>true</bool></property>
                            </widget>
                          </item>
                          <item row="1" column="0" colspan="2">
                            <widget class="QCheckBox" name="TCMSaveDICOMCheckBoxImg">
                              <property name="toolTip"><string>Save generated quantitative maps as DICOM Parametric Map objects.</string></property>
                              <property name="text"><string>Save as DICOM Parametric Map</string></property>
                            </widget>
                          </item>
                          <item row="2" column="0">
                            <widget class="QLabel" name="TCMDICOMDirectoryLabelImg">
                              <property name="text"><string>Output directory</string></property>
                            </widget>
                          </item>
                          <item row="2" column="1">
                            <widget class="ctkPathLineEdit" name="TCMDICOMDirectoryImg">
                              <property name="enabled"><bool>false</bool></property>
                              <property name="toolTip"><string>Directory for DICOM Parametric Map export. Series names will be derived from the generated map names.</string></property>
                              <property name="filters">
                                <set>ctkPathLineEdit::Dirs|ctkPathLineEdit::Drives|ctkPathLineEdit::NoDot|ctkPathLineEdit::NoDotDot|ctkPathLineEdit::Readable</set>
                              </property>
                            </widget>
                          </item>
                        </layout>
                      </widget>
                    </item>

                    <!-- Standard voxelwise TCM fitting -->
                    <item>
                      <widget class="QPushButton" name="FITbuttonTCMImg">
                        <property name="toolTip">
                          <string>Fit selected TCM models voxelwise and generate their parametric maps using the selected output options.</string>
                        </property>
                        <property name="text">
                          <string>Fit &amp; generate TCM maps</string>
                        </property>
                      </widget>
                    </item>

                    <!-- Optimized TCM parameter maps. Enabled once fitted voxelwise model results are available. -->
                    <item>
                      <widget class="ctkCollapsibleButton" name="TCMOptimizationCollapsibleButtonImg">
                        <property name="enabled"><bool>false</bool></property>
                        <property name="text"><string>Voxelwise Model Selection</string></property>
                        <property name="collapsed"><bool>true</bool></property>
                        <layout class="QGridLayout" name="TCMOptimizationLayoutImg">
                          <item row="0" column="0" colspan="2">
                            <widget class="QLabel" name="TCMOptimizationInfoLabelImg">
                              <property name="wordWrap"><bool>true</bool></property>
                              <property name="text">
                                <string>The selected criterion chooses the best fitted model at each voxel. With statistical testing enabled, nested models use LRT and non-nested models use Vuong. If a simpler model is not significantly different from the criterion-selected model, the simplest such model is preferred.</string>
                              </property>
                            </widget>
                          </item>
                          <item row="1" column="0">
                            <widget class="QLabel" name="TCMOptimizationModelsLabelImg">
                              <property name="text"><string>Models to compare</string></property>
                            </widget>
                          </item>
                          <item row="1" column="1">
                            <widget class="QPushButton" name="TCMOptimizationModelsSelectAllImg">
                              <property name="text"><string>All/No Models</string></property>
                            </widget>
                          </item>
                          <item row="2" column="0" colspan="2">
                            <widget class="QScrollArea" name="TCMOptimizationModelsScrollAreaImg">
                              <property name="widgetResizable"><bool>true</bool></property>
                              <property name="maximumHeight"><number>120</number></property>
                              <widget class="QWidget" name="TCMOptimizationModelsCheckContentsImg">
                                <property name="styleSheet"><string notr="true">background-color: white;</string></property>
                                <layout class="QVBoxLayout" name="TCMOptimizationModelsCheckLayoutImg"/>
                              </widget>
                            </widget>
                          </item>
                          <item row="3" column="0">
                            <widget class="QLabel" name="TCMSelectionCriterionLabelImg">
                              <property name="text"><string>Selection criterion</string></property>
                            </widget>
                          </item>
                          <item row="3" column="1">
                            <widget class="QComboBox" name="TCMSelectionCriterionComboImg">
                              <property name="toolTip"><string>AIC, BIC, MASE and chi2 are minimized.</string></property>
                              <item><property name="text"><string>AIC</string></property></item>
                              <item><property name="text"><string>BIC</string></property></item>
                              <item><property name="text"><string>MASE</string></property></item>
                              <item><property name="text"><string>chi2</string></property></item>
                            </widget>
                          </item>
                          <item row="4" column="0" colspan="2">
                            <widget class="QCheckBox" name="TCMUseStatTestsCheckBoxImg">
                              <property name="text"><string>Use statistical tests</string></property>
                              <property name="toolTip"><string>Compare each alternative model only against the criterion-selected best model. If models are not significantly different, prefer the one with fewer fitted parameters.</string></property>
                            </widget>
                          </item>
                          <item row="5" column="0">
                            <widget class="QLabel" name="TCMStatAlphaLabelImg">
                              <property name="text"><string>Significance level</string></property>
                            </widget>
                          </item>
                          <item row="5" column="1">
                            <widget class="QDoubleSpinBox" name="TCMStatAlphaSpinBoxImg">
                              <property name="enabled"><bool>false</bool></property>
                              <property name="decimals"><number>3</number></property>
                              <property name="minimum"><double>0.001000000000000</double></property>
                              <property name="maximum"><double>0.500000000000000</double></property>
                              <property name="singleStep"><double>0.010000000000000</double></property>
                              <property name="value"><double>0.050000000000000</double></property>
                            </widget>
                          </item>
                          <item row="6" column="0" colspan="2">
                            <widget class="QGroupBox" name="TCMOptimizationParametersGroupImg">
                              <property name="title"><string>Output parameters</string></property>
                              <layout class="QGridLayout" name="TCMOptimizationParametersLayoutImg">
                                <item row="0" column="0"><widget class="QCheckBox" name="TCMOptK1CheckBoxImg"><property name="text"><string>K1</string></property><property name="checked"><bool>true</bool></property></widget></item>
                                <item row="0" column="1"><widget class="QCheckBox" name="TCMOptk2CheckBoxImg"><property name="text"><string>k2</string></property><property name="checked"><bool>true</bool></property></widget></item>
                                <item row="0" column="2"><widget class="QCheckBox" name="TCMOptk3CheckBoxImg"><property name="text"><string>k3</string></property><property name="checked"><bool>true</bool></property></widget></item>
                                <item row="0" column="3"><widget class="QCheckBox" name="TCMOptk4CheckBoxImg"><property name="text"><string>k4</string></property><property name="checked"><bool>true</bool></property></widget></item>
                                <item row="1" column="0"><widget class="QCheckBox" name="TCMOptvbCheckBoxImg"><property name="text"><string>vb</string></property><property name="checked"><bool>true</bool></property></widget></item>
                                <item row="1" column="1"><widget class="QCheckBox" name="TCMOpttdCheckBoxImg"><property name="text"><string>td</string></property><property name="checked"><bool>true</bool></property></widget></item>
                                <item row="1" column="2"><widget class="QCheckBox" name="TCMOptKiCheckBoxImg"><property name="text"><string>Ki</string></property><property name="checked"><bool>true</bool></property></widget></item>
                                <item row="1" column="3"><widget class="QCheckBox" name="TCMOptDVCheckBoxImg"><property name="text"><string>DV</string></property><property name="checked"><bool>true</bool></property></widget></item>
                              </layout>
                            </widget>
                          </item>
                          <item row="7" column="0" colspan="2">
                            <widget class="QPushButton" name="GenerateTCMOptimizedImgButton">
                              <property name="text">
                                <string>Generate optimized TCM maps</string>
                              </property>
                              <property name="toolTip">
                                <string>Generate quantitative parameter maps and a model-selection visualization from the voxelwise selected TCM model.</string>
                              </property>
                            </widget>
                          </item>
                        </layout>
                      </widget>
                    </item>

                  </layout>
                </widget>

              </widget>
